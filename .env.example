# Copy this file to .env and fill in your key. Never commit .env.

# Required to run the agent and the live evaluation (not needed for `pytest`).
OPENAI_API_KEY=

# Optional. Model used by the agent.
OPENAI_MODEL=gpt-6-luna

# Optional. Retrieval settings (defaults shown).
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-es
RAG_TOP_K=3
RAG_MIN_SCORE=0.20
